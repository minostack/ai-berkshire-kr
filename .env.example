# =============================================================================
# AI Berkshire KR — 환경변수 템플릿
# =============================================================================
# 사용법:
#   1) cp .env.example .env        (Windows: copy .env.example .env)
#   2) .env 파일에 실제 키 값 입력
#   3) pip install python-dotenv
#
# 주의:
#   - .env 는 .gitignore에 등록되어 있습니다. 절대 커밋하지 마세요.
#   - 이 파일(.env.example)에는 실제 키를 절대 넣지 마세요. 플레이스홀더만.
#   - 값에 따옴표는 불필요합니다.  KEY=값  형식으로 그대로 작성하세요.
#   - 값에 # 이 포함되면 주석으로 잘릴 수 있으니 따옴표로 감싸세요.
#
# ⚠ 우선순위: 이미 설정된 OS 환경변수 > .env
#   Windows 사용자 환경변수에 같은 이름의 키가 남아 있으면 .env 값이 무시됩니다.
#   .env로 완전히 이전하려면 아래로 기존 사용자 환경변수를 제거하세요(PowerShell):
#     [Environment]::SetEnvironmentVariable("KIS_APP_KEY", $null, "User")
#   (제거 후 터미널을 새로 열어야 반영됩니다)
# =============================================================================


# -----------------------------------------------------------------------------
# 한국투자증권(KIS) Open API  —  tools/daily_scanner.py
# 발급: https://apiportal.koreainvestment.com/
# -----------------------------------------------------------------------------
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호-상품코드 형식 (예: 50123456-01)
KIS_ACCOUNT_NO=


# -----------------------------------------------------------------------------
# 키움증권 REST API  —  tools/kiwoom_cvd_obv_scanner.py, tools/update_index.py
# 발급: https://openapi.kiwoom.com
# -----------------------------------------------------------------------------
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=


# -----------------------------------------------------------------------------
# DART 전자공시 Open API  —  tools/kstock_data.py, tools/kr_scanner.py
# 발급: https://opendart.fss.or.kr/intro/main.do
# 미설정 시 네이버금융 URL 안내로 자동 대체됩니다.
# -----------------------------------------------------------------------------
DART_API_KEY=


# =============================================================================
# 아래는 선택 항목 — 해당 도구를 쓸 때만 설정하면 됩니다.
# =============================================================================

# -----------------------------------------------------------------------------
# 동방재부(East Money) 종목 검색 토큰  —  tools/ashare_data.py (중국 A주)
# 미설정 시 소스코드의 공개 기본 토큰으로 동작합니다. 보통 비워두면 됩니다.
# -----------------------------------------------------------------------------
EASTMONEY_SEARCH_TOKEN=

# -----------------------------------------------------------------------------
# FinMind API 토큰  —  tools/twstock_data.py (대만주)
# 미설정 시 익명 호출(시간당 요청 제한 있음). 발급: https://finmindtrade.com/
# local/finmind_token.txt 파일로도 설정 가능합니다.
# -----------------------------------------------------------------------------
FINMIND_TOKEN=

# -----------------------------------------------------------------------------
# GitHub 개인 액세스 토큰  —  tools/star_history_chart.py (레포 관리용)
# 발급: gh auth token  또는  https://github.com/settings/tokens
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
